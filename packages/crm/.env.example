# Copy to .env.local and fill in.
#
# The app runs WITHOUT these — it falls back to seeded in-memory data so the UI
# can be worked on before a cloud project exists. Set them to go live.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site origin for metadata and deployment configuration.
# OAuth returns to the browser's current origin at /auth/callback, which must be
# allowlisted in Supabase. The local port must match the server you actually run.
# Local example: http://127.0.0.1:3200 · Production: your HTTPS deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authenticated server-to-server contact intake. Workspace ID is the canonical
# tenant binding; the owner ID is a temporary compatibility alias. Configure at
# least one binding. If both are present they must identify the same active owner
# workspace or the endpoint fails closed without writing.
SUPABASE_SERVICE_ROLE_KEY=
OMNIX_INTAKE_WORKSPACE_ID=
OMNIX_INTAKE_OWNER_ID=
OMNIX_INTAKE_TOKEN=

# Calendar date used when a physical mailing is checked. Use the Realtor's IANA zone.
OMNIX_TIME_ZONE=America/New_York

# Optional deployment-wide fallback for conversational routing. Workspace
# owners can instead configure an encrypted key in Settings → Omnix AI.
# Gemini receives only the bounded
# user question and returns one allowlisted deterministic Omnix query. It never
# receives CRM records or credentials. For customer/PII workloads, enable only
# on a paid Google Cloud project covered by the applicable data terms.
OMNIX_GEMINI_ENABLED=false
OMNIX_GEMINI_DATA_POLICY=disabled
OMNIX_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Used by the CLI only; point it to the deployed route above.
OMNIX_INTAKE_URL=http://localhost:3000/api/intake/contacts

# Mailchimp Story 4.1. Omnix never requests an API key or platform password.
# Registered-app OAuth credentials are server-only. Each provider-issued
# webhook signing secret is encrypted per connection; there is no shared env secret. The
# provider starts in UAT mode; set REAL_ACCOUNT_UAT=approved only after the
# connect -> audience -> tag -> unsubscribe -> reconcile -> disconnect matrix.
OMNIX_CONNECTOR_MAILCHIMP_ENABLED=false
OMNIX_CONNECTOR_MAILCHIMP_REAL_ACCOUNT_UAT=pending
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
MAILCHIMP_REDIRECT_URI=http://127.0.0.1:3200/api/connectors/mailchimp/callback
MAILCHIMP_WEBHOOK_BASE_URL=http://127.0.0.1:3200/api/connectors/mailchimp/webhook
# CLI OAuth only. Generate a private URL-safe value with at least 43 characters;
# use the same value for oauth-start and oauth-complete, then clear it.
OMNIX_MAILCHIMP_OAUTH_SESSION_SECRET=

# Google Story 4.2. This is separate from Supabase identity sign-in. Feature
# scopes are requested incrementally and remain in UAT until scope review plus
# real-account send/sync/calendar/revoke evidence are approved.
OMNIX_CONNECTOR_GOOGLE_ENABLED=false
OMNIX_CONNECTOR_GOOGLE_SCOPE_REVIEW=pending

# Story 4.3 — Twilio texting remains UAT-only until every explicit approval is
# set to `approved`. API credentials, webhook auth token and bodies are server-only.
OMNIX_CONNECTOR_TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WEBHOOK_AUTH_TOKEN=
TWILIO_CALLBACK_BASE_URL=http://127.0.0.1:3200
TWILIO_CALLBACK_ENDPOINT_KEY=
OMNIX_CONNECTOR_TWILIO_REGISTRATION_APPROVED=pending
OMNIX_CONNECTOR_TWILIO_POLICY_APPROVED=pending
OMNIX_CONNECTOR_TWILIO_CALLBACK_UAT=pending
OMNIX_CONNECTOR_TWILIO_REAL_NUMBER_UAT=pending
OMNIX_TWILIO_APPROVED_USE_CASE=realtor.follow-up
OMNIX_TWILIO_DISCLOSURE_VERSION=omnix-texting-disclosure.v1
OMNIX_TWILIO_POLICY_HASH=
OMNIX_TWILIO_KEYWORD_CONFIGURATION_HASH=
OMNIX_TWILIO_REGISTRATION_STATE=not_configured
OMNIX_TWILIO_REGISTRATION_EVIDENCE_HASH=
OMNIX_TWILIO_RETENTION_DAYS=365
OMNIX_TWILIO_QUIET_HOURS_START=20:00
OMNIX_TWILIO_QUIET_HOURS_END=08:00
OMNIX_CONNECTOR_GOOGLE_REAL_ACCOUNT_UAT=pending
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=
GOOGLE_CONNECTOR_REDIRECT_URI=http://127.0.0.1:3200/api/connectors/google/callback
# Gmail metadata push/watch. Google Pub/Sub must issue a signed OIDC token to
# this exact HTTPS URL and audience. The topic must grant publish authority to
# gmail-api-push@system.gserviceaccount.com. Never expose the endpoint key.
GOOGLE_GMAIL_PUBSUB_TOPIC=
GOOGLE_GMAIL_PUBSUB_SUBSCRIPTION=
GOOGLE_GMAIL_PUSH_SERVICE_ACCOUNT_EMAIL=
GOOGLE_GMAIL_PUSH_ENDPOINT_KEY=
GOOGLE_GMAIL_PUSH_EXTERNAL_URL=
GOOGLE_GMAIL_PUSH_AUDIENCE=
# CLI OAuth only. Private URL-safe value, 43–256 characters; clear after use.
OMNIX_GOOGLE_OAUTH_SESSION_SECRET=

# Story 4.4 — inbound Facebook Page / Instagram Professional enquiries only.
# There is deliberately no default Graph API version: verify the current
# numeric version against Meta's official changelog before enabling even UAT.
OMNIX_CONNECTOR_META_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_REDIRECT_URI=http://127.0.0.1:3200/api/connectors/meta/callback
META_WEBHOOK_BASE_URL=http://127.0.0.1:3200/api/connectors/meta/webhook
META_WEBHOOK_ENDPOINT_KEY=
META_GRAPH_API_VERSION=
META_GRAPH_API_VERSION_VERIFIED_AT=
META_GRAPH_API_VERSION_SOURCE_URL=https://developers.facebook.com/docs/graph-api/changelog/versions
# Instagram Business Login endpoints must be copied from the current official
# Meta product setup. They deliberately have no guessed default.
META_INSTAGRAM_AUTHORIZATION_ENDPOINT=
META_INSTAGRAM_TOKEN_ENDPOINT=
# Facebook endpoints are derived from the pinned Graph version unless an
# operator explicitly supplies the equivalent official endpoint.
META_FACEBOOK_AUTHORIZATION_ENDPOINT=
META_FACEBOOK_TOKEN_ENDPOINT=
OMNIX_CONNECTOR_META_BUSINESS_VERIFIED=pending
OMNIX_CONNECTOR_META_APP_REVIEW_APPROVED=pending
OMNIX_CONNECTOR_META_BUSINESS_VERIFICATION_EVIDENCE=
OMNIX_CONNECTOR_META_APP_REVIEW_EVIDENCE=
OMNIX_CONNECTOR_META_RETENTION_POLICY_APPROVED=pending
OMNIX_CONNECTOR_META_REAL_ACCOUNT_UAT=pending

# AES-256-GCM envelope key references used by every connector secret. Values
# are base64-encoded 32-byte KEKs; keep prior versions during key rotation.
OMNIX_CONNECTOR_KEK_ACTIVE_VERSION=v1
OMNIX_CONNECTOR_KEK_v1=

# Epic 11 — Morning brief notifications (Web Push). Generate once with
# `npx web-push generate-vapid-keys`. The public key is safe to expose; keep the
# private key server-only. Subject must be a mailto: address you monitor.
# Delivery runs from the daily cron /api/internal/push/morning-brief (CRON_SECRET).
NEXT_PUBLIC_OMNIX_PUSH_PUBLIC_KEY=
OMNIX_PUSH_PRIVATE_KEY=
OMNIX_PUSH_SUBJECT=
